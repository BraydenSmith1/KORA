# ==============================================================================
# KORA Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
#
# For production, use a secrets manager (AWS Secrets Manager, Vault, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
POSTGRES_USER=kora
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kora
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
JWT_SECRET=your_jwt_secret_here_use_a_long_random_string

# API URLs (update for your domain)
API_URL=https://api.kora.yourdomain.com
WEB_URL=https://kora.yourdomain.com
OPTIMIZER_URL=https://optimizer.kora.yourdomain.com

# ------------------------------------------------------------------------------
# Optimizer Configuration
# ------------------------------------------------------------------------------
KORA_SITE_CONFIG=/app/sites/mahavelona.yaml
KORA_LOG_FORMAT=json
KORA_LOG_LEVEL=INFO
KORA_CACHE_ENABLED=true
KORA_API_URL=http://api:4000

# Modbus/RTDS connection (for live telemetry)
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502

# ------------------------------------------------------------------------------
# Monitoring & Alerting
# ------------------------------------------------------------------------------
# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Operations phone for SMS alerts
OPS_PHONE=+261123456789

# Log aggregation (Axiom - https://axiom.co)
# Get your token from: https://app.axiom.co/settings/api-tokens
AXIOM_TOKEN=
AXIOM_DATASET=kora-logs
AXIOM_ORG_ID=
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# SSL/HTTPS (if using Caddy)
# ------------------------------------------------------------------------------
# ACME_EMAIL=admin@yourdomain.com
# DOMAIN=kora.yourdomain.com

# ------------------------------------------------------------------------------
# Development Only
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:4000
